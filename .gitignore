# ---------------------------------------------------------------
# Playa — was NICHT ins Repository gehoert
# ---------------------------------------------------------------

# Virtuelle Umgebung (460 MB, wird per requirements.txt neu erzeugt)
.venv/
venv/
env/

# PyInstaller-Ausgabe (128 MB + 15 MB, wird von build.bat erzeugt)
build/
dist/
*.manifest

# Inno-Setup-Ausgabe (der fertige Installer, 63 MB)
# Der gehoert als Release-Anhang auf GitHub, nicht ins Repository.
installer/Setup/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Editoren
.vscode/
.idea/

# Windows
Thumbs.db
desktop.ini

# Shows und Testmaterial — damit nie versehentlich fremde
# Aufnahmen oder Kundendateien im Repository landen
*.playa
*.wav
*.flac
*.mp3
*.ogg
*.aiff
*.aif
